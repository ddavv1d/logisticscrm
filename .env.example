# Copy to .env and fill in. NEVER commit the real .env.
# ---------------------------------------------------------------

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/logisticscrm

# --- Auth / security ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=lc_session
CSRF_COOKIE_NAME=lc_csrf
# minutes
SESSION_MAX_AGE=43200

# --- App ---
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
# base currency (v1 single-currency)
DEFAULT_CURRENCY=USD

# --- NOTE ---
# The 21st.dev API key is NOT here — it lives in ~/.claude.json
# (projects → /Users/dato/Desktop/LogisticsCRM → mcpServers → 21st).
# Never put it in the repo.
